{
  "name": "dsh-eyes",
  "version": "0.3.2",
  "description": "Eyes for official DeepSeek-V4: paste/drag images, PDF, video, Office. Settings pick the vision backend.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "adapter.js",
    "vision.js",
    "media.js",
    "intake.js",
    "cli-vision.js",
    "persist.js",
    "settings-api.js",
    "client.js",
    "peers.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "ocr"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-cordis-client-runner"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/losebird/dsh-eyes.git"
  },
  "homepage": "https://github.com/losebird/dsh-eyes"
}
